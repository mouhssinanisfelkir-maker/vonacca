# Copiez ce fichier en ".env" puis remplissez les valeurs
# (ou lancez ./scripts/init-env.sh qui génère un .env avec des secrets aléatoires).
# IMPORTANT : ne jamais versionner ni partager le fichier .env.

# --- Base de données ---
POSTGRES_DB=vona
POSTGRES_USER=vona
# Lettres et chiffres uniquement (le mot de passe est inséré dans une URL de connexion)
POSTGRES_PASSWORD=changez-moi-lettres-et-chiffres

# --- Sécurité ---
# Clé de signature des sessions : 32 caractères minimum (ex. : openssl rand -hex 32)
JWT_SECRET=changez-moi-avec-une-longue-valeur-aleatoire

# --- Premier compte administrateur (créé au premier démarrage) ---
ADMIN_EMAIL=admin@vona.local
# 8 caractères minimum ; l'admin devra le changer à sa première connexion
ADMIN_PASSWORD=changez-moi-123

# --- Réseau ---
# Port HTTP exposé sur la machine
HTTP_PORT=80
# Passer à "true" dès que le site est servi en HTTPS (Azure, reverse proxy TLS...)
# ATTENTION : en HTTP simple, laisser "false" sinon la connexion est impossible.
COOKIE_SECURE=false

# --- Vidéos ---
# Taille maximale d'une vidéo en Mo (nginx est réglé pour 2100 Mo)
MAX_VIDEO_MB=2048

# --- Démo ---
# "true" = crée un compte RH (rh@vona.local) et 3 apprenants de test, mot de passe : Vona2026!
# À laisser à "false" en production.
SEED_DEMO=false
